{
  "manifest_version": 3,
  "name": "Dead Links Scanner",
  "version": "1.1.0",
  "description": "Professional Web Crawler, Error Analyzer and Passive Security Assessment Browser Extension",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content_security.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
